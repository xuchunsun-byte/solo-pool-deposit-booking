# Solo Pool Deposit Booking — local / deploy env
# Copy to .env and fill in. Never commit .env or real secrets.

PORT=3000
# Public origin of THIS app (magic links, booking URLs, webhook base).
# Local: http://localhost:3000
# After a public HTTPS deploy, set the real origin (no trailing slash).
APP_URL=http://localhost:3000

# Required in production. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# SQLite file. Default is ./data/app.db relative to the app root.
# DATABASE_PATH=./data/app.db

# Creem — SaaS subscription only (tech pays $29/mo).
# Do not put a customer-deposit product here.
CREEM_PRODUCT_ID=prod_JyQlU86FhnSLYstg4Eaie
# From Creem dashboard → Developers → Webhook. Leave empty locally
# until you have a real secret; the webhook route will fail closed (HTTP 500).
CREEM_WEBHOOK_SECRET=

# Optional cron protection for POST /internal/cron/reminders
CRON_SECRET=

# Email (access + booking confirmation + T-24h reminder).
# If no provider is configured, messages are appended to data/mail.log only.
EMAIL_FROM=
# Resend: https://resend.com — set EMAIL_FROM to a verified sender.
RESEND_API_KEY=
# Or SMTP (used when RESEND_API_KEY is empty):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Google Calendar OAuth is NOT required for this pass.
# Bookings always get an ICS file + a Google Calendar template link.
# If you later add OAuth, these are the placeholders — leave empty for now.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local / demo only. When true, POST /dev/grant-access can mark an email
# paid and send (or log) an access link WITHOUT a real Creem charge.
# Must stay false in any public deployment.
ALLOW_DEV_GRANT=true

# Optional: static thanks/cancel pages on the existing GitHub Pages preview
# (not the app). Safe to leave as-is. Do not use these to host checkout.
PUBLIC_THANKS_URL=https://xuchunsun-byte.github.io/solo-pool-deposit-booking/thanks.html
PUBLIC_CANCEL_URL=https://xuchunsun-byte.github.io/solo-pool-deposit-booking/cancelled.html
